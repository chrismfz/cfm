[Unit]
Description=CFM daemon
After=network-online.target
Wants=network-online.target

[Service]
# Auto-create needed dirs
StateDirectory=cfm
LogsDirectory=cfm
RuntimeDirectory=cfm

StateDirectoryMode=0700
LogsDirectoryMode=0700
RuntimeDirectoryMode=0700

WorkingDirectory=/var/lib/cfm


# Process basics
Type=simple

ExecStart=/usr/bin/cfm daemon -c /etc/cfm/
ExecReload=/bin/kill -HUP $MAINPID

Restart=always
RestartSec=5

TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077


# File logging (since you're not using the journal)
StandardOutput=append:/var/log/cfm/cfm-service.log
StandardError=append:/var/log/cfm/cfm-error.log



[Install]
WantedBy=multi-user.target
