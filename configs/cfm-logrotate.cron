#!/bin/sh
# CFM hourly logrotate pass  ->  /etc/cron.hourly/cfm-logrotate
#
# /etc/logrotate.d/logrotate-cfm caps the edge access logs with `maxsize`, but
# maxsize only takes effect when logrotate actually runs, and the distro
# cron/timer runs it once a day. A busy edge writes tens of GB in a day, so
# once-a-day is far too coarse: without this pass access.log grows until
# copytruncate + compress no longer fit on disk, after which it never rotates
# again.
#
# No -s: logrotate's built-in default state file is the same one the distro's
# daily run uses, so that run sees the rotations we performed here and the
# time-based directives (daily / rotate N) are not applied twice.
set -e

CONF=/etc/logrotate.d/logrotate-cfm

# The Apache TSV fallback log (httpd-cfm.conf, the web detector's file source
# when the edge socket is off: `cfm dnat off`). logrotate-cfm leaves
# /var/log/apache2 to the distro's apache2 block, but cPanel has none: its
# cpanellogd renames a log past 2 GB to <name>.YYYY_MM_DD[.NN] and never
# deletes the copies. On 2026-11-17 that held 316 GB on titan, 207 GB on mars
# and 120 GB on orion; virgo's live file had reached 26 GB unrotated. Its only
# reader follows the live file, so keep a day of copies and cap the live file
# by truncating it in place (Apache opens it O_APPEND, so writes go on at the
# new end; the tailer reopens a file that shrank). Not a logrotate block: on a
# distro whose apache2 config globs *.log, listing the path again is a
# "duplicate log entry" error that aborts the whole run.
TSV_MAX_BYTES=536870912
for f in /var/log/apache2/access_cfm_tsv.log /usr/local/apache/logs/access_cfm_tsv.log; do
    [ -f "$f" ] || continue
    find "$(dirname "$f")" -maxdepth 1 -type f -name "$(basename "$f")?*" -mmin +1440 -delete 2>/dev/null || true
    sz=$(stat -c %s "$f" 2>/dev/null || echo 0)
    if [ "$sz" -gt "$TSV_MAX_BYTES" ]; then
        : > "$f" 2>/dev/null || true
    fi
done

[ -r "$CONF" ] || exit 0
command -v logrotate >/dev/null 2>&1 || exit 0

# A concurrent daily run holds the state-file lock, and a previous hourly pass
# may still be copying a multi-GB access log; skipping this hour is harmless,
# the next hour picks it up. Never exit non-zero for a skipped or failed run —
# cron would mail the operator every hour.
LOCK=/var/lock/cfm-logrotate.lock
[ -d /var/lock ] || LOCK=/tmp/cfm-logrotate.lock

if command -v flock >/dev/null 2>&1; then
    flock -n "$LOCK" logrotate "$CONF" || exit 0
else
    logrotate "$CONF" || exit 0
fi

exit 0
