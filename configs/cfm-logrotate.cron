#!/bin/sh
# CFM hourly logrotate pass  ->  /etc/cron.hourly/cfm-logrotate
#
# /etc/logrotate.d/logrotate-cfm caps the edge access logs with `maxsize`, but
# maxsize only takes effect when logrotate actually runs, and the distro
# cron/timer runs it once a day. A busy edge writes tens of GB in a day, so
# once-a-day is far too coarse: without this pass access.log grows until
# copytruncate + compress no longer fit on disk, after which it never rotates
# again.
#
# No -s: logrotate's built-in default state file is the same one the distro's
# daily run uses, so that run sees the rotations we performed here and the
# time-based directives (daily / rotate N) are not applied twice.
set -e

CONF=${CFM_LOGROTATE_CONF:-/etc/logrotate.d/logrotate-cfm}

# The web detector's TSV fallback log (httpd-cfm.conf / nginx-cfm.conf, its
# file source when the edge socket is off: `cfm dnat off`). logrotate-cfm
# leaves /var/log/apache2 and /var/log/nginx to the distro, but cPanel has no
# block there: its cpanellogd renames a log past 2 GB to
# <name>.YYYY_MM_DD[.NN] and never deletes the copies. On 2026-11-17 that held
# 316 GB on titan, 207 GB on mars and 175 GB on orion; virgo's live file had
# reached 26 GB unrotated. So: delete cPanel's dated copies after a day (only
# that name form: a distro logrotate generation or an operator's own copy is
# left alone), and past TSV_MAX_BYTES keep ONE compressed copy of the live file
# (<name>.cfm-prev.gz, overwritten each time) and truncate it in place: the web
# server opens it O_APPEND, so writes go on at the new end, and the tailer
# reopens a file that shrank. Not a logrotate block: on a distro whose apache2
# or nginx config globs *.log, listing the path again is a "duplicate log
# entry" error that aborts the whole run. CFM_TSV_LOGS overrides the list
# (tests).
TSV_MAX_BYTES=${CFM_TSV_MAX_BYTES:-536870912}
TSV_LOGS=${CFM_TSV_LOGS:-"/var/log/apache2/access_cfm_tsv.log /usr/local/apache/logs/access_cfm_tsv.log /var/log/nginx/access_cfm_tsv.log"}
for f in $TSV_LOGS; do
    [ -f "$f" ] || continue
    find "$(dirname "$f")" -maxdepth 1 -type f \
        -name "$(basename "$f").[0-9][0-9][0-9][0-9]_[0-9][0-9]_[0-9][0-9]*" \
        -mmin +1440 -delete 2>/dev/null || true
    sz=$(stat -c %s "$f" 2>/dev/null || echo 0)
    if [ "$sz" -gt "$TSV_MAX_BYTES" ]; then
        gzip -c "$f" > "$f.cfm-prev.gz.tmp" 2>/dev/null &&
            mv -f "$f.cfm-prev.gz.tmp" "$f.cfm-prev.gz" 2>/dev/null || rm -f "$f.cfm-prev.gz.tmp"
        : > "$f" 2>/dev/null || true
    fi
done

[ -r "$CONF" ] || exit 0
command -v logrotate >/dev/null 2>&1 || exit 0

# cfm-edge's logs (/var/log/cfm-edge/) are rotated by the cfm-edge package's
# own /etc/logrotate.d/cfm-edge, never by logrotate-cfm (two entries for one
# path is a "duplicate log entry" error that aborts the run). Its `maxsize`
# needs the same hourly pass as the OpenResty logs, so this run reads that
# file too, when the package is installed.
set -- "$CONF"
EDGE_CONF=${CFM_EDGE_LOGROTATE_CONF:-/etc/logrotate.d/cfm-edge}
[ -r "$EDGE_CONF" ] && set -- "$@" "$EDGE_CONF"

# A concurrent daily run holds the state-file lock, and a previous hourly pass
# may still be copying a multi-GB access log; skipping this hour is harmless,
# the next hour picks it up. Never exit non-zero for a skipped or failed run —
# cron would mail the operator every hour.
LOCK=/var/lock/cfm-logrotate.lock
[ -d /var/lock ] || LOCK=/tmp/cfm-logrotate.lock

if command -v flock >/dev/null 2>&1; then
    flock -n "$LOCK" logrotate "$@" || exit 0
else
    logrotate "$@" || exit 0
fi

exit 0
