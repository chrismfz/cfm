/usr/local/openresty/nginx/logs/access.log /usr/local/openresty/nginx/logs/error.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    create 0640 root root
    postrotate
        # Reopen log files without full restart
        if [ -f /usr/local/openresty/nginx/logs/nginx.pid ]; then
            kill -USR1 $(cat /usr/local/openresty/nginx/logs/nginx.pid) 2>/dev/null || true
        fi
    endscript
}
