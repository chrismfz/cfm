# cfm dnat cpanel listener template for @ENGINE@.
# NOTE: generated when `cfm dnat cpanel on` is enabled; listeners run with a single human-entry challenge policy.
# Install path: @LISTENER_DEST@

# HTTPS panel listeners
server {
    listen 12083 ssl;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Fallback cert (used if sslcollector has not loaded yet)
    ssl_certificate /var/lib/cfm/certs/selfsigned/fullchain.pem;
    ssl_certificate_key /var/lib/cfm/certs/selfsigned/privkey.pem;

    # Dynamic per-host certs from sslcollector (SNI-aware)
    ssl_certificate_by_lua_block { local sc = require "sslcollector"; sc.set_cert() }

    set $cfm_panel_origin "https://127.0.0.1:2083";
    set $cfm_panel_challenge_mode "forced"; set $cfm_panel_fail_mode "fail-open";
    set $cfm_pass "";
    set $cfm_upstream "cfm_panel_2083";
    access_by_lua_file /var/lib/cfm/lua/cfm_panel.lua;
    location = /__cfm_panel_decide { internal; proxy_pass http://cfm_challenge; proxy_bind 127.0.0.1; proxy_set_header Host $host; proxy_set_header Proxy ""; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Server $host; proxy_set_header CF-Connecting-IP $remote_addr; proxy_request_buffering off; proxy_buffering off; proxy_connect_timeout 300s; proxy_read_timeout 300s; proxy_send_timeout 300s; }
    location = /__cfm_challenge { access_by_lua_block { return; } proxy_pass http://cfm_challenge; proxy_bind 127.0.0.1; proxy_set_header Host $host; proxy_set_header Proxy ""; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Port 2083; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-Server $host; proxy_set_header CF-Connecting-IP $remote_addr; proxy_request_buffering off; proxy_buffering off; proxy_connect_timeout 300s; proxy_read_timeout 300s; proxy_send_timeout 300s; }
    location = /__cfm_verify { access_by_lua_block { return; } proxy_pass http://cfm_challenge; proxy_bind 127.0.0.1; proxy_set_header Host $host; proxy_set_header Proxy ""; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Port 2083; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-Server $host; proxy_set_header CF-Connecting-IP $remote_addr; proxy_request_buffering off; proxy_buffering off; proxy_connect_timeout 300s; proxy_read_timeout 300s; proxy_send_timeout 300s; }
    location / { proxy_pass $cfm_pass; proxy_bind 127.0.0.1; proxy_set_header Host $host; proxy_set_header Proxy ""; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Port 2083; proxy_set_header X-Forwarded-Proto https; proxy_set_header X-Forwarded-Server $host; proxy_set_header CF-Connecting-IP $remote_addr; proxy_redirect ~^https://([^/:]+):2083(/xfercpanel(?:/.*|\?.*)?)$ https://$1:2087$2; proxy_request_buffering off; proxy_buffering off; proxy_connect_timeout 300s; proxy_read_timeout 300s; proxy_send_timeout 300s; }
}
