    ssl_certificate_by_lua_block { local sc = require "sslcollector"; sc.set_cert() }

    # Keep HSTS conservative for panel hostnames: HTTPS-only for one day, with
    # no includeSubDomains/preload, so operators can safely raise it later.
    add_header Strict-Transport-Security "max-age=86400" always;

    # Friendly handler for old bookmarks or mistyped http://host:<secure-panel-port>/ URLs.
    # nginx/OpenResty/Angie raise 497 when plaintext HTTP is sent to an SSL listener.
    error_page 497 = @cfm_plain_http_panel_https;

    location @cfm_plain_http_panel_https {
