}
# HTTP panel listeners
# Note: HTTP listeners terminate plain HTTP on internal ports and proxy to
#       cpsrvd HTTP panel ports.
server {
    listen 12082;
    server_name _;
    set $cfm_panel_origin "http://127.0.0.1:2082";
    set $cfm_panel_challenge_mode "forced"; set $cfm_panel_fail_mode "fail-open";
    set $cfm_pass "";
    set $cfm_upstream "cfm_panel_2082";
    access_by_lua_file /var/lib/cfm/lua/cfm_panel.lua;

    # Internal policy decision hop to challenge backend.
    location = /__cfm_panel_decide { internal; proxy_pass http://cfm_challenge; proxy_bind 127.0.0.1; proxy_set_header Host $host; proxy_set_header Proxy ""; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Port 2082; proxy_set_header X-CFM-Panel-Port 2082; proxy_set_header X-Forwarded-Proto http; proxy_set_header X-Forwarded-Server $host; proxy_set_header CF-Connecting-IP $remote_addr; proxy_request_buffering off; proxy_buffering off; proxy_connect_timeout 300s; proxy_read_timeout 300s; proxy_send_timeout 300s; }
    location = /__cfm_challenge { access_by_lua_block { return; } proxy_pass http://cfm_challenge; proxy_bind 127.0.0.1; proxy_set_header Host $host; proxy_set_header Proxy ""; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Port 2082; proxy_set_header X-CFM-Panel-Port 2082; proxy_set_header X-Forwarded-Proto http; proxy_set_header X-Forwarded-Server $host; proxy_set_header CF-Connecting-IP $remote_addr; proxy_request_buffering off; proxy_buffering off; proxy_connect_timeout 300s; proxy_read_timeout 300s; proxy_send_timeout 300s; }
    location = /__cfm_verify { access_by_lua_block { return; } proxy_pass http://cfm_challenge; proxy_bind 127.0.0.1; proxy_set_header Host $host; proxy_set_header Proxy ""; proxy_set_header X-Real-IP $remote_addr; proxy_set_header X-Forwarded-For $remote_addr; proxy_set_header X-Forwarded-Host $host; proxy_set_header X-Forwarded-Port 2082; proxy_set_header X-CFM-Panel-Port 2082; proxy_set_header X-Forwarded-Proto http; proxy_set_header X-Forwarded-Server $host; proxy_set_header CF-Connecting-IP $remote_addr; proxy_request_buffering off; proxy_buffering off; proxy_connect_timeout 300s; proxy_read_timeout 300s; proxy_send_timeout 300s; }
    location ~ ^/acctxferrsync(/|$) { access_by_lua_block { return; } content_by_lua_file /var/lib/cfm/lua/cfm_panel_tunnel.lua; }
