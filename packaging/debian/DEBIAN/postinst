#!/bin/sh
set -e

# ---------------------------------------------------------------------------
# cfm system user and group
#
# The cfm group is used by OpenResty (SSLCollector unix socket, cfm_token.lua).
# The cfm user is the identity OpenResty workers run under.
# Both are created here so they exist before the daemon starts on first install
# and are preserved on upgrade (getent guards make the calls idempotent).
# ---------------------------------------------------------------------------
if ! getent group cfm >/dev/null 2>&1; then
    groupadd --system cfm
fi

if ! getent passwd cfm >/dev/null 2>&1; then
    useradd \
        --system \
        --gid cfm \
        --no-create-home \
        --home-dir /var/lib/cfm \
        --shell /sbin/nologin \
        --comment "CFM service account" \
        cfm
fi

# ensure config dir, force 0700 on both new and upgrade installs.
# /etc/cfm holds bypass lists, kernsec.conf, lsm.conf and other root-only
# config; anything needing non-root read access lives in /var/lib/cfm/.
mkdir -p /etc/cfm
chmod 0700 /etc/cfm

# ---------------------------------------------------------------------------
# /etc/cfm files: the rpm's %config(noreplace), done by hand.
#
# They are NOT dpkg conffiles (packaging/etc-cfm-files.list says why: dpkg
# stopped every upgrade to ask, apt -y cannot answer it, and
# unattended-upgrades skipped cfm). Per file of the list:
#   - missing                       -> install the shipped default (also
#                                      when it was deleted: as the rpm does);
#   - untouched since we installed  -> replace it with the new default;
#   - edited (by hand or by CFM)    -> keep it, put the new default beside it
#                                      as <name>.dpkg-dist (the .rpmnew).
# "Untouched" is the sha256 recorded below when we last installed the file.
# A node coming from the conffile packages has no record yet: dpkg's status
# still lists each old conffile (now obsolete) with the md5 of the version it
# shipped, and that answers the same question once.
# ---------------------------------------------------------------------------
CFM_ETC_LIST=/usr/share/cfm/etc-cfm-files.list
CFM_ETC_SUMS=/var/lib/cfm/etc-cfm-files.sha256
cfm_etc_recorded() { # <name> -> recorded sha256, or nothing
    if [ -f "$CFM_ETC_SUMS" ]; then
        awk -v n="$1" '$2 == n { print $1; exit }' "$CFM_ETC_SUMS"
    fi
}
cfm_etc_dpkg_md5() { # <path> -> md5 dpkg recorded for the old conffile, or nothing
    dpkg-query -W -f='${Conffiles}\n' cfm 2>/dev/null | awk -v p="$1" '$1 == p { print $2; exit }'
}
if [ -f "$CFM_ETC_LIST" ]; then
    mkdir -p /var/lib/cfm
    cfm_etc_new=$(mktemp /var/lib/cfm/.etc-cfm-files.sha256.XXXXXX)
    trap 'rm -f "$cfm_etc_new"' EXIT
    grep -Ev '^[[:space:]]*(#|$)' "$CFM_ETC_LIST" | while read -r name mode; do
        src=/usr/share/cfm/configs/$name
        dst=/etc/cfm/$name
        [ -f "$src" ] || continue
        new_sum=$(sha256sum "$src" | cut -d' ' -f1)
        if [ ! -e "$dst" ]; then
            install -m "$mode" "$src" "$dst"
            echo "$new_sum $name" >>"$cfm_etc_new"
            continue
        fi
        cur_sum=$(sha256sum "$dst" | cut -d' ' -f1)
        old_sum=$(cfm_etc_recorded "$name")
        pristine=0
        if [ "$cur_sum" = "$new_sum" ]; then
            pristine=1
        elif [ -n "$old_sum" ]; then
            if [ "$cur_sum" = "$old_sum" ]; then pristine=1; fi
        else
            old_md5=$(cfm_etc_dpkg_md5 "$dst")
            if [ -n "$old_md5" ] && [ "$(md5sum "$dst" | cut -d' ' -f1)" = "$old_md5" ]; then
                pristine=1
            fi
        fi
        # A symlinked file is never replaced (mv would swap the link for a
        # plain file): it gets the .dpkg-dist like an edited one.
        if [ -L "$dst" ] && [ "$cur_sum" != "$new_sum" ]; then pristine=0; fi
        if [ "$pristine" = 1 ]; then
            if [ "$cur_sum" != "$new_sum" ]; then
                # keep the operator's mode and owner, like dpkg / rpm do
                cp "$src" "$dst.dpkg-new"
                chmod --reference="$dst" "$dst.dpkg-new"
                chown --reference="$dst" "$dst.dpkg-new"
                mv -f "$dst.dpkg-new" "$dst"
                echo "CFM config: updated /etc/cfm/$name to the new default"
            fi
            rm -f "$dst.dpkg-dist"
            echo "$new_sum $name" >>"$cfm_etc_new"
        else
            if ! cmp -s "$src" "$dst.dpkg-dist" 2>/dev/null; then
                install -m "$mode" "$src" "$dst.dpkg-dist"
                echo "CFM config: kept your /etc/cfm/$name; the new default is /etc/cfm/$name.dpkg-dist"
            fi
            # Still edited: keep the hash of the last version we installed, so
            # a later revert to it reads as untouched again ("-" = none known;
            # the line also tells postrm's purge the file is ours).
            echo "${old_sum:--} $name" >>"$cfm_etc_new"
        fi
    done
    chmod 0644 "$cfm_etc_new"
    mv -f "$cfm_etc_new" "$CFM_ETC_SUMS"
    trap - EXIT
fi

# detectors.conf overlay directory (docs/detectors-config-unification.md par.4):
# per-host overrides live here so the base file stays pristine and
# package-updateable. The package ships it EMPTY and never installs files
# into it — operator (and, later, the WebUI editor) content only.
mkdir -p /etc/cfm/detectors.d
chmod 0700 /etc/cfm/detectors.d


# kernsec.conf may reveal host hardening exceptions. Tighten only by
# removing group/other bits so upgrades do not loosen operator-chosen owner
# bits (for example 0400 stays 0400).
[ -f /etc/cfm/kernsec.conf ] && chmod go-rwx /etc/cfm/kernsec.conf || true

# lsm.conf discloses which BPF LSM policies are active on the host;
# same lock-down as kernsec.conf.
[ -f /etc/cfm/lsm.conf ] && chmod go-rwx /etc/cfm/lsm.conf || true

# webdetector_challenge_paths.txt is retired (2026-11-18): CHALLENGE_PATHS has
# read webdetector_malpaths.txt since 2026-03-12 and the package no longer
# ships it. dpkg's own helper drops the conffile (an edited copy is kept as
# .dpkg-bak); the same call is in preinst and postrm, as rm_conffile requires.
# A config that still names the file reads the malpath list instead
# (webdetector.ResolveChallengePathsFile).
if command -v dpkg-maintscript-helper >/dev/null 2>&1; then
    dpkg-maintscript-helper rm_conffile /etc/cfm/webdetector_challenge_paths.txt 2026.11.19~ cfm -- "$@"
fi

# Per-server API/MaxMind secrets overlay. Seed an editable 0600 template on
# first install only; never overwrite an operator's existing file. It is
# deliberately NOT a dpkg conffile, so upgrades leave it untouched.
if [ ! -e /etc/cfm/cfm.api.conf ] && [ -f /usr/share/cfm/configs/cfm.api.conf.example ]; then
    # Guard against set -e (line 2): seeding is a convenience, never fatal —
    # a failure here must not abort the rest of postinst (Lua sync, proxy
    # deploy, service restart). Matches the file's `|| true` convention.
    cp -p /usr/share/cfm/configs/cfm.api.conf.example /etc/cfm/cfm.api.conf 2>/dev/null || true
    chmod 0600 /etc/cfm/cfm.api.conf 2>/dev/null || true
fi

# shared Lua runtime dir (root writable, cfm readable)
mkdir -p /var/lib/cfm/lua
chown root:cfm /var/lib/cfm/lua
chmod 0750 /var/lib/cfm/lua

# enforce ownership/mode on shipped Lua payload
if [ -d /var/lib/cfm/lua ]; then
    find /var/lib/cfm/lua -type f -exec chown root:cfm {} +
    find /var/lib/cfm/lua -type f -exec chmod 0640 {} +
fi


# NOTE: Lua modules are delivered by the PACKAGE MANAGER, not by this script.
# The package installs them straight to /var/lib/cfm/lua/ and owns every one,
# so an upgrade installs new modules, refreshes changed ones and REMOVES
# modules the new version dropped - all of it before this script runs.
#
# A hand-rolled "seed/refresh" loop used to live here, copying from
# /usr/share/cfm/configs/lua over the files the package had just installed. It
# behaved differently per packaging, and was useless in both:
#   - deb: that source was never shipped, so the loop only ever fell through to
#     "WARNING: packaged lua source path missing" on every install and upgrade,
#     about a path that is not supposed to exist.
#   - rpm: the source WAS shipped (the spec %install copied the whole configs/
#     tree unfiltered, so every module rode along a second time), and the loop
#     re-copied ~900 KB over byte-identical files and rewrote a sha256 stamp
#     each run. Its headline policy - "locally modified -> backup and
#     force-refresh" - could never fire on an upgrade anyway: rpm replaces
#     /var/lib/cfm/lua/* BEFORE %post runs, so by the time the loop compares
#     hashes the operator edit is already gone and the hashes already match.
# Removed 2026-09-22; the rpm no longer ships the duplicate source tree either.
#
# A hand-edit under /var/lib/cfm/lua/ IS overwritten on upgrade with no backup.
# That was always true - the loop never actually changed it. These are code
# files, deliberately not %config (a .rpmnew would freeze security code at the
# operator version). `rpm -V cfm` / `dpkg --verify cfm` already report such
# edits. Edit /etc/cfm/*, never /var/lib/cfm/lua/*.

# Retire the stamp directory the removed loop wrote into. The stamps are ours
# and nothing reads them now; on rpm hosts the directory is NOT empty (one
# .sha256 per module), so a bare rmdir would fail and orphan them forever.
rm -f /var/lib/cfm/lua/.packaged/*.sha256 2>/dev/null || true
rmdir /var/lib/cfm/lua/.packaged 2>/dev/null || true

# cPanel/WHM plugin: refresh the live plugin CODE on upgrade (non-disruptive;
# no register_appconfig / install_plugin / cpsrvd restart). Acts only when cPanel
# is present and the plugin is already installed. Shared with the rpm %post via
# scripts/cpanel-plugin-refresh.sh so the two packaging scripts can't drift.
if [ -x /usr/share/cfm/scripts/cpanel-plugin-refresh.sh ]; then
    /usr/share/cfm/scripts/cpanel-plugin-refresh.sh || true
fi

# nginx temp dirs — must be owned by the cfm worker user
# (default OpenResty paths are root-owned; workers running as cfm can't write them)
for d in /var/lib/cfm/nginx/client_body_temp /var/lib/cfm/nginx/proxy_temp; do
    mkdir -p "$d"
    chown cfm:cfm "$d"
    chmod 700 "$d"
done

# Site Cache — provision the cache dirs BEFORE the deploy helper
# below runs `openresty -t` / `angie -t`: every proxy_cache_path dir must exist
# for the config test to pass (a missing /var/cache/nginx parent is an [emerg],
# so on a first install the packaged conf was silently not deployed). The
# helper also makes the parent traversable by the cfm workers and purges a
# cache tree they cannot use (left in another group by an older run); it is the ONE copy of this
# logic, shared with the rpm %post and both edge installers. Never fatal here.
if [ -x /usr/share/cfm/scripts/cfm-cache-dirs.sh ]; then
    /usr/share/cfm/scripts/cfm-cache-dirs.sh || echo "WARNING: CFM cache dir provisioning reported a problem (see above)"
else
    echo "WARNING: CFM cache dir helper missing: /usr/share/cfm/scripts/cfm-cache-dirs.sh"
fi

# Validate and deploy packaged Angie/OpenResty configs for installed engines.
if [ -x /usr/share/cfm/scripts/package-proxy-config-deploy.sh ]; then
    /usr/share/cfm/scripts/package-proxy-config-deploy.sh || true
else
    echo "WARNING: CFM proxy config deploy helper missing: /usr/share/cfm/scripts/package-proxy-config-deploy.sh"
fi

# Reload edge proxies if they are currently active. We do this AFTER
# the cfm restart cycle below, not before — that way fresh angie/openresty
# workers run init_worker_by_lua against a cfm that is already up and
# has its socket + snapshot ready, instead of racing the restart and
# falling back through soft-start retries. We never enable or start a
# service here: hosts may run neither, only one, or both.

# systemd reload/enable/start (cfm first, then edge proxies below)
if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable cfm.service || true
    systemctl restart cfm.service || true
fi

# Now reload the edge proxies so their workers re-init against the
# ready cfm. Short sleep gives cfm a moment to create
# /var/run/sslcollector.sock and rewrite /var/lib/cfm/sslcollector/dump.json
# with the correct 0640 perms — both prerequisites for a clean
# init_worker_by_lua run.
if command -v systemctl >/dev/null 2>&1; then
    sleep 2
    for svc in angie.service openresty.service cfm-edge.service; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            echo "CFM: reloading $svc to apply updated config..."
            systemctl reload "$svc" || true
        fi
    done
fi

exit 0
